{
  "name": "HinH agent harness",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install -g @openai/codex || true",
  "postAttachCommand": {
    "wizard-of-oz": "npm start"
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Wizard of Oz",
      "onAutoForward": "silent"
    }
  },
  "hostRequirements": {
    "cpus": 2
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  }
}
